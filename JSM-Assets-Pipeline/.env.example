# Copy to .env for local runs. On Cloud Run, create each of these as a
# Secret Manager secret of the same name, labelled app=jira-assets-pipeline.

# CrowdStrike Falcon
CS_CLIENT_ID=
CS_CLIENT_SECRET=
CS_BASE_URL=https://api.crowdstrike.com
CS_GROUP_ID_MAC=
CS_GROUP_ID_WIN=

# Microsoft Intune (Graph)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Kandji / Iru
KANDJI_API_URL=https://SUBDOMAIN.api.kandji.io/api/v1/devices
KANDJI_API_URL_ADE=
KANDJI_API_TOKEN=

# NinjaOne
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
NINJA_INSTANCE_URL=https://app.ninjarmm.com

# Workday RaaS
WORKDAY_RAAS_URL=https://WORKDAY_HOST/ccx/service/customreport2/TENANT/OWNER/REPORT_NAME
WORKDAY_RAAS_USERNAME=ISU_NAME@TENANT
WORKDAY_RAAS_PASSWORD=

# JSM Assets Data Manager
DM_WORKSPACE_ID=
DM_ADAPTERS_TOKEN=
DM_IMPORT_TOKEN=
